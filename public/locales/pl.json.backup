    "about": {
      "title": "O ECM Digital",
      "subtitle": "Zespół ekspertów AI, którzy transformują biznes poprzez inteligentne rozwiązania",
      "mainTitle": "AI, które realnie dowozi",
      "description": "Łączymy strategię, UX i inżynierię. Projektujemy, testujemy i wdrażamy rozwiązania AI, które przekładają się na wyniki biznesowe.",
